# Postgres DB
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mappify?schema=public"

# Google OAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID="replace-with-your-rotated-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-your-rotated-google-client-secret"

# OpenAI
OPENAI_API_KEY="replace-with-your-openai-api-key"
OPENAI_MAP_MODEL="gpt-4o"
OPENAI_MAP_OUTLINE_MODEL="gpt-image-1"
OPENAI_MAP_GEOMETRY_STRATEGY="outline-generation"

# Developer Tools
DEBUG_UI=false
